<div class="Sidebar__Container" data-js-sidebar>
  <button class="Sidebar__Toggle" data-js-toggle>
      <img src='/src/assets/images/default/Hamburger2.svg' alt='' class='Sidebar__ToggleIcon' loading="lazy" />
  </button>
  <ul class="Sidebar__List" data-js-sidebar-list>
    {{#each nav_items}}
      <li class="Sidebar__ListItem">
        {{name}}
      </li>
    {{/each}}
  </ul>
</div>
