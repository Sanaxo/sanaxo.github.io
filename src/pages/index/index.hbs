<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{index.title}}</title>
      {{> loading/loading}}</head>
<body>
  <div class="Main">
    <div class="Navigation">
      {{> sidebar-navigation/sidebar-navigation nav_items=index.model}}
    </div>
    {{#each index.model}}
      {{> multiple-swiper-galleries/multiple-swiper-galleries name=name images=images}}
    {{/each}}
  </div>

  <script defer src='index.js'></script>
</body>
</html>